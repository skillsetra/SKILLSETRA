# Demo defaults — API requests use the same-origin Next.js proxy.
NEXT_PUBLIC_DEMO_MODE=true
NEXT_PUBLIC_API_BASE_URL=
NEXT_PUBLIC_API_TIMEOUT_MS=20000

# Supabase client authentication for real user accounts (public anon key only).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-side Next.js proxy target. Leave at the default for local full-stack mode.
BACKEND_INTERNAL_URL=http://127.0.0.1:8000

# Public site URL for canonical links, sitemap and robots (no trailing slash).
NEXT_PUBLIC_SITE_URL=

# Private /admin/login credentials (server-side only; never use NEXT_PUBLIC_ here).
# Set all three values in frontend/.env.local or your hosting secret settings.
# ADMIN_USERNAME: your chosen admin username.
# ADMIN_PASSWORD: a unique password with at least 12 characters.
# ADMIN_SESSION_SECRET: a random secret with at least 32 characters.
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
